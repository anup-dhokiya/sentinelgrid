{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SentinelGridSecurityEvent",
  "description": "Standardized schema for sanitized security events reported by SentinelGrid connectors.",
  "type": "object",
  "required": [
    "event_id",
    "timestamp",
    "organization_id",
    "website_id",
    "connector_id",
    "client",
    "request",
    "detection",
    "action_taken",
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for the security event."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp when the request occurred."
    },
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "website_id": {
      "type": "string",
      "format": "uuid"
    },
    "connector_id": {
      "type": "string",
      "format": "uuid"
    },
    "client": {
      "type": "object",
      "required": ["ip_address"],
      "properties": {
        "ip_address": {
          "type": "string",
          "description": "Source IP address (IPv4 or IPv6)."
        },
        "ip_hash": {
          "type": "string",
          "description": "Pseudonymized hash of client IP for privacy-preserving telemetry."
        },
        "user_agent": {
          "type": "string",
          "maxLength": 512
        },
        "country_code": {
          "type": "string",
          "maxLength": 2
        },
        "client_fingerprint": {
          "type": "string"
        }
      }
    },
    "request": {
      "type": "object",
      "required": ["method", "path"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS", "TRACE", "CONNECT"]
        },
        "path": {
          "type": "string",
          "maxLength": 2048
        },
        "query_parameters_sanitized": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Sanitized key-value pairs (sensitive fields like passwords/tokens masked)."
        },
        "headers_sanitized": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Sanitized request headers (authorization/cookie values masked)."
        },
        "content_type": {
          "type": "string"
        },
        "body_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "detection": {
      "type": "object",
      "required": ["risk_score", "matched_rules"],
      "properties": {
        "risk_score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 100.0,
          "description": "Calculated composite risk score (0-100)."
        },
        "risk_breakdown": {
          "type": "object",
          "properties": {
            "signature_score": { "type": "number", "minimum": 0, "maximum": 100 },
            "behavior_score": { "type": "number", "minimum": 0, "maximum": 100 },
            "reputation_score": { "type": "number", "minimum": 0, "maximum": 100 },
            "frequency_score": { "type": "number", "minimum": 0, "maximum": 100 },
            "context_score": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        },
        "matched_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule_id", "category", "severity"],
            "properties": {
              "rule_id": { "type": "string" },
              "rule_name": { "type": "string" },
              "category": {
                "type": "string",
                "enum": [
                  "sqli",
                  "xss",
                  "path_traversal",
                  "rfi_lfi",
                  "command_injection",
                  "suspicious_http_method",
                  "credential_stuffing",
                  "rate_abuse",
                  "bot_abuse",
                  "reputation_blacklist"
                ]
              },
              "severity": {
                "type": "string",
                "enum": ["low", "medium", "high", "critical"]
              },
              "matched_location": {
                "type": "string",
                "enum": ["path", "query", "header", "body", "cookie"]
              },
              "confidence": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0
              }
            }
          }
        }
      }
    },
    "action_taken": {
      "type": "string",
      "enum": ["allow", "monitor", "challenge", "block"]
    },
    "http_response_code": {
      "type": "integer",
      "description": "HTTP status code returned to the client (e.g., 200, 403, 429)."
    },
    "execution_duration_ms": {
      "type": "number",
      "minimum": 0.0,
      "description": "Total inspection latency overhead in milliseconds."
    }
  }
}
