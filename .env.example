# ==============================================================================
# SentinelGrid Environment Configuration Template
# ==============================================================================

# Core Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL 16
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_secret
POSTGRES_DB=sentinelgrid
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_secret@postgres:5432/sentinelgrid

# Redis 7
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# RabbitMQ 3.12
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//

# Security & Cryptography
JWT_SECRET=replace_with_64_character_cryptographically_secure_random_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
POLICY_SIGNING_KEY=replace_with_master_policy_signing_secret_in_production

# Telemetry & Ingestion Limits
MAX_EVENT_BATCH_SIZE=500
INGESTION_RATE_LIMIT_PER_SEC=5000
MAX_CONNECTOR_BUFFER_CAPACITY=5000
DEFAULT_ALLOWED_TRAFFIC_SAMPLE_RATE=0.05

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/v1
